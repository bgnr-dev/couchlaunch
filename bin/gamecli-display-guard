#!/bin/bash
# Display guard: restores the desktop display mode when a stream ended without a
# clean shutdown (no active stream, no game running, but a switched mode pending).
set -uo pipefail
STAMP="$HOME/.cache/game-launcher/display-restore"
[ -f "$STAMP" ] || exit 0

# active stream? (Sunshine control + video ports)
if ss -Htn 2>/dev/null | grep -qE ':(47984|47989|48010)\b'; then exit 0; fi
if ss -Hun 2>/dev/null | grep -qE ':(47998|47999|48000)\b'; then exit 0; fi

# a game still running? (gamecli prints "<running>/<total> game(s) running")
if "$HOME/.local/bin/gamecli" running 2>/dev/null | grep -qE '^[1-9][0-9]*/[0-9]+ game'; then exit 0; fi

"$HOME/.local/bin/gamecli" restoreres
logger -t gamecli-display-guard "display mode restored (no stream/game active)"
