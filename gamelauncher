def cmd_run(args) -> None:
    g = load_game(args.slug)
    LOG_DIR.mkdir(parents=True, exist_ok=True)
    log = open(LOG_DIR / f"{g['slug']}.log", "ab", buffering=0)
    log.write(f"\n===== {time.strftime('%F %T')} start {g['name']} =====\n".encode())

    if g["type"] == "steam":
        cmd = ["steam", f"steam://rungameid/{g['steam_appid']}"]
        env = os.environ.copy()
    else:
        umu = shutil.which("umu-run")
        if not umu:
            die("umu-run is not installed (e.g. sudo pacman -S umu-launcher)")
        exe = g["path"]
        if not Path(exe).exists():
            die(f"exe not found: {exe}")
        prefix = str(g.get("prefix") or (PREFIX_ROOT / g["slug"]))
        Path(prefix).mkdir(parents=True, exist_ok=True)
        env = os.environ.copy()
        env["WINEPREFIX"] = prefix
        env["GAMEID"] = g["slug"]
        if g.get("protonpath"):
            env["PROTONPATH"] = g["protonpath"]
        cmd = [umu, exe] + (shlex.split(g["args"]) if g.get("args") else [])

    log.write(f"cmd: {' '.join(cmd)}\n".encode())

    # Sunshine exposes the resolution the client asked for: match the host monitor to it,
    # so we do not render at 4K and downscale when the client only wants 1080p.
    saved = None
    if not os.environ.get("GAMECLI_NO_DISPLAY_SWITCH"):
        try:
            def _parse_mode(spec: str):
                m = re.match(r"^(\d+)x(\d+)(?:@(\d+(?:\.\d+)?))?$", (spec or "").strip())
                return (int(m.group(1)), int(m.group(2)), float(m.group(3)) if m.group(3) else None) if m else (0, 0, None)

            client_w = int(os.environ.get("SUNSHINE_CLIENT_WIDTH") or 0)
            client_h = int(os.environ.get("SUNSHINE_CLIENT_HEIGHT") or 0)
            if client_w and client_h:
                # launched by Sunshine/Moonlight: follow the client resolution
                w, h, f = client_w, client_h, (float(os.environ.get("SUNSHINE_CLIENT_FPS") or 0) or None)
                ow, oh, of = _parse_mode(g.get("display_stream", ""))
                if ow and oh:
                    w, h, f = ow, oh, (of or f)
            else:
                # local launch (desktop/terminal): run natively, switch only when asked
                w, h, f = _parse_mode(g.get("display", ""))
            if w and h:
                log.write(f"client resolution: {w}x{h}@{f}\n".encode())
                saved = set_monitor_mode(w, h, f)
        except Exception as e:  # a display switch must never block the launch
            log.write(f"display switch hiba: {e}\n".encode())

    try:
        rc = subprocess.call(cmd, env=env, stdout=log, stderr=subprocess.STDOUT, cwd=str(Path(g.get("path", HOME)).parent))
        log.write(f"exit: {rc}\n".encode())
    finally:
        restore_monitor_mode(saved)
        log.close()



def _proc_table() -> list[tuple[int, int, str]]:
    """(pid, elapsed_seconds, cmdline) rows."""
    out = subprocess.run(["ps", "-eo", "pid=,etimes=,args="], capture_output=True, text=True).stdout
    rows = []
    for line in out.splitlines():
        parts = line.strip().split(None, 2)
        if len(parts) < 3:
            continue
        try:
            rows.append((int(parts[0]), int(parts[1]), parts[2]))
        except ValueError:
            continue
    return rows


def _running_info(g: dict, table: list[tuple[int, int, str]]) -> tuple[int, int, str] | None:
    """Return (pid, elapsed_s, cmdline) when the game is running."""
    if not table:
        return None
    exe = os.path.basename(g.get("path") or "").lower()
    prefix = str(g.get("prefix") or "")
    for pid, et, cmd in table:
        low = cmd.lower()
        if exe and exe in low:
            # the wine/umu launcher process that runs the game exe
            if "umu-run" in low or "wine" in low or "proton" in low or "reaper" in low:
                return (pid, et, cmd)
    for pid, et, cmd in table:
        if exe and os.path.basename(cmd.split()[0]).lower() == exe:
            return (pid, et, cmd)
    if g.get("type") == "steam" and g.get("steam_appid"):
        # Steam game: the steam_app_<appid> window class is the tell
        try:
            cl = _hyprctl_json(["clients"]) or []
            for c in cl:
                if (c.get("class") or "") == f"steam_app_{g['steam_appid']}":
                    return (0, 0, "steam ablak nyitva")
        except Exception:
            pass
    return None


def _fmt_time(sec: int) -> str:
    h, m = divmod(sec // 60, 60)
    return f"{h}h{m:02d}m" if h else f"{m}m{sec % 60:02d}s"


def cmd_running(args) -> None:
    """Which registered game is currently running."""
    table = _proc_table()
    games = all_games()
    running = []
    for g in games:
        info = _running_info(g, table)
        if info:
            running.append((g, info))
    if not running:
        print("no registered game is running")
    else:
        for g, (pid, et, _cmd) in running:
            extra = f"pid {pid}, {_fmt_time(et)}" if pid else "steam ablak"
            print(f"▶ {g['name']:<26} {g['slug']:<20} {extra}")
    print(f"\n{len(running)}/{len(games)} game(s) running")


def cmd_list(args) -> None:
    games = all_games()
    if not games:
        print("no games registered yet — gamelauncher add <name> <dir|exe>")
        return
    table = _proc_table()
    for g in games:
        target = (g.get("path")
                  or (f"steam://rungameid/{g['steam_appid']}" if g.get("steam_appid") else None)
                  or (f"(installer pending: {g['installer']})" if g.get("installer") else "(not configured)"))
        info = _running_info(g, table)
        state = f"▶ FUT ({_fmt_time(info[1])})" if info and info[0] else ("▶ FUT" if info else "·")
        print(f"{g['slug']:<28} {g['name']:<24} {g['type']:<6} {state:<14} {target}")


def cmd_remove(args) -> None:
    p = registry_path(args.slug)
    if not p.exists():
        die(f"no such game: {args.slug}")
    p.unlink()
    print(f"removed from registry: {args.slug}")
