def main() -> None:
    ap = argparse.ArgumentParser(prog="gamelauncher", description="Proton/umu game launcher with Sunshine/Moonlight integration")
    sub = ap.add_subparsers(dest="cmd", required=True)

    a = sub.add_parser("add", help="register a game")
    a.add_argument("name")
    a.add_argument("path", nargs="?")
    a.add_argument("--exe", help="executable to run (when the directory contains several)")
    a.add_argument("--args", default="")
    a.add_argument("--steam-appid")
    a.add_argument("--slug")
    a.add_argument("--prefix")
    a.add_argument("--proton", help="explicit Proton directory (PROTONPATH), e.g. ~/.local/share/Steam/compatibilitytools.d/GE-Proton9-20")
    a.add_argument("--dest", help="archive extraction target (default: <games_root>/<name>)")
    a.add_argument("--image", help="Sunshine cover image (default: steam.png)")
    a.add_argument("--no-sync", action="store_true")
    a.set_defaults(func=cmd_add)

    r = sub.add_parser("run", help="launch a game (this is what Sunshine calls)")
    r.add_argument("slug")
    r.set_defaults(func=cmd_run)

    s = sub.add_parser("sync", help="regenerate Sunshine apps.json")
    s.add_argument("--restart", action="store_true")
    s.set_defaults(func=lambda a: sync_sunshine(restart=a.restart))

    rel = sub.add_parser("relocate", help="move an in-prefix installed game into the games directory")
    rel.add_argument("slug")
    rel.add_argument("--dest", help="destination root (default: games_root)")
    rel.add_argument("--dirname", help="destination directory name (default: game name)")
    rel.set_defaults(func=cmd_relocate)

    ins = sub.add_parser("install", help="run an installer (ISO/repack) under Proton, copy crack files, register")
    ins.add_argument("slug")
    ins.add_argument("--no-relocate", dest="relocate", action="store_false",
                     help="do not move the game into the games directory (leave it in the prefix)")
    ins.set_defaults(func=cmd_install)

    ic = sub.add_parser("icon", help="set the game icon/cover (Moonlight tile)")
    ic.add_argument("slug")
    ic.add_argument("--file", help="local image file")
