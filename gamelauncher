# ---------- scene ISOs / installer releases ----------

CRACK_GROUPS = ("razor1911", "razor", "codex", "plaza", "skidrow", "fairlight", "hoodlum",
                "reloaded", "empress", "tenoke", "goldberg", "rune", "elamigos", "dodi", "fitgirl")
INSTALLER_NAMES = ("setup.exe", "install.exe", "setup32.exe", "setup64.exe")


def mount_iso(iso: Path, slug: str) -> Path:
    """Loop-mount egy ISO-t stabil helyre (/mnt/scene/<slug>)."""
    mnt = Path("/mnt/scene") / slug
    subprocess.run(["sudo", "-n", "mkdir", "-p", str(mnt)], check=True)
    if subprocess.run(["mountpoint", "-q", str(mnt)]).returncode != 0:
        print(f"mounting ISO: {iso.name} -> {mnt}")
        subprocess.run(["sudo", "-n", "mount", "-o", "loop,ro", str(iso), str(mnt)], check=True)
    return mnt


def find_installer(root: Path) -> Path | None:
    for name in INSTALLER_NAMES:
        for p in root.rglob(name):
            if p.is_file():
                return p
    cands = [p for p in root.rglob("*.exe") if p.is_file() and looks_like_installer(p)]
    return cands[0] if cands else None


def find_crack_dir(root: Path) -> Path | None:
    """Crack directory: known group name, or just .dll+.exe without large data files."""
    for d in [x for x in root.iterdir() if x.is_dir()]:
        low = d.name.lower()
        if any(g in low for g in CRACK_GROUPS):
            return d
    for d in [x for x in root.iterdir() if x.is_dir()]:
        files = [f for f in d.rglob("*") if f.is_file()]
        if not files:
            continue
        small = all(f.stat().st_size < 64 * 1024 * 1024 for f in files)
        has_dll = any(f.suffix.lower() == ".dll" for f in files)
        has_exe = any(f.suffix.lower() == ".exe" for f in files)
        if small and has_dll and has_exe:
            return d
    return None


SYSTEM_EXE = ("winedbg", "winecfg", "cmd", "taskmgr", "iexplore", "notepad", "wordpad",
              "regedit", "explorer", "control", "msiexec", "conhost", "rundll32",
              "start.exe", "winemine", "wineboot", "winevdm", "svchost", "dxdiag")
SKIP_DIRS = ("windows", "Program Files/Internet Explorer", "Program Files/Common Files",
             "Program Files (x86)/Internet Explorer", "Program Files (x86)/Common Files",
             "Program Files/Windows NT", "Program Files (x86)/Windows NT",
             "ProgramData", "users/Public")


def find_installed_exe(prefix: Path, game_name: str = "") -> Path | None:
    """Find the most likely *game* exe inside a prefix (system executables excluded)."""
    root = prefix / "drive_c"
    if not root.exists():
        return None
    name = game_name.lower().replace(" ", "")
    cands = []
    for p in root.rglob("*.exe"):
        try:
            if not p.is_file():
                continue
            rel = p.relative_to(root).as_posix()
            low = p.name.lower()
            if any(low.startswith(s) or s in low for s in SYSTEM_EXE):
                continue
            if any(k in low for k in ("unins", "setup", "vcredist", "dxsetup", "crashhandler",
                                      "launcher_updater", "dotnet", "oalinst", "redist", "helper")):
                continue
            if any(rel.startswith(d + "/") for d in SKIP_DIRS):
                continue
            cands.append((p, rel))
        except OSError:
            continue
    if not cands:
        return None

    def score(item):
        p, rel = item
        stem = p.stem.lower().replace(" ", "")
        name_hit = 2 if (name and stem == name) else (1 if (name and (name in stem or stem in name)) else 0)
        in_games = 1 if rel.lower().startswith("games/") else 0
        try:
            size = p.stat().st_size
            mtime = p.stat().st_mtime
        except OSError:
            size = mtime = 0
        return (name_hit, in_games, mtime, size)

    return max(cands, key=score)[0]


def copy_crack(crack: Path, target_dir: Path) -> int:
    """Copy crack contents next to the installed game."""
    n = 0
    for f in crack.rglob("*"):
        if not f.is_file():
            continue
        dest = target_dir / f.relative_to(crack)
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(f, dest)
        n += 1
    return n


def cmd_install(args) -> None:
    """Run an installer under Proton (GUI), then copy any crack files and register the game."""
    g = load_game(args.slug)
    prefix = Path(g.get("prefix") or (PREFIX_ROOT / g["slug"]))
    prefix.mkdir(parents=True, exist_ok=True)
    iso = Path(g["iso"]) if g.get("iso") else None
    mnt = Path(g["iso_mount"]) if g.get("iso_mount") else None
    if iso and (mnt is None or not mnt.exists() or subprocess.run(["mountpoint", "-q", str(mnt)]).returncode != 0):
        mnt = mount_iso(iso, g["slug"])
    setup = Path(g["installer"]) if g.get("installer") else (find_installer(mnt) if mnt else None)
    if not setup or not setup.exists():
        die("installer not found")
    umu = shutil.which("umu-run") or die("umu-run is not installed")
    env = os.environ.copy()
    env["WINEPREFIX"] = str(prefix)
    env["GAMEID"] = g["slug"]
    log_path = LOG_DIR / f"{g['slug']}-install.log"
    LOG_DIR.mkdir(parents=True, exist_ok=True)
    print(f"starting installer under Proton: {setup}")
    print(f"  prefix: {prefix}")
    print("  (the installer window appears on the host display / in the stream)")
    with open(log_path, "ab", buffering=0) as log:
        log.write(f"\n===== {time.strftime('%F %T')} install {g['name']} =====\n".encode())
        rc = subprocess.call([umu, str(setup)], env=env, cwd=str(setup.parent),
                             stdout=log, stderr=subprocess.STDOUT)
    print(f"installer exited: rc={rc} (log: {log_path})")

    exe = find_installed_exe(prefix, g.get("name", ""))
    if not exe:
        die("no installed exe found in the prefix — check the log")
    print(f"installed exe: {exe}")
    crack = Path(g["crack_dir"]) if g.get("crack_dir") else (find_crack_dir(mnt) if mnt else None)
    if crack and crack.exists():
        n = copy_crack(crack, exe.parent)
        print(f"copied {n} crack file(s) to: {exe.parent}")
    else:
        print("no crack directory — copy the files manually if you need them")

    g["path"] = str(exe)
    g.pop("installer", None)
    registry_path(g["slug"]).write_text(json.dumps(g, indent=2, ensure_ascii=False) + "\n")

    if getattr(args, "relocate", True):
        # move game files into the games directory; the prefix keeps Wine state only
        try:
            relocate_game(g)
        except SystemExit:
            print("  (relocation skipped — later: gamelauncher relocate " + g["slug"] + ")")
        except Exception as e:
            print(f"  (relocation failed: {e} — later: gamelauncher relocate {g['slug']})")

    print("registry updated, launch with: gamelauncher run " + g["slug"])
    sync_sunshine(restart=True)



def relocate_game(g: dict, dest_root=None, dirname=None) -> Path | None:
    """Move a game installed inside the prefix into the games directory (prefix keeps Wine state)."""
    exe = Path(g.get("path") or "")
    if not exe.exists():
        die(f"exe not found: {exe}")
    prefix = Path(g.get("prefix") or (PREFIX_ROOT / g["slug"]))
    try:
        exe.relative_to(prefix)
    except ValueError:
        print(f"nothing to do: the game already lives outside the prefix ({exe})")
        return exe
    src_dir = exe.parent
    dest = Path(dest_root or DEFAULT_GAMES_ROOT) / (dirname or g["name"])
    if dest.exists():
        die(f"destination already exists: {dest}")
    dest.parent.mkdir(parents=True, exist_ok=True)
    print(f"moving: {src_dir} -> {dest}")
    subprocess.run(["rsync", "-aH", str(src_dir) + "/", str(dest) + "/"], check=True)
    a = subprocess.run(["du", "-sb", str(src_dir)], capture_output=True, text=True).stdout.split()[0]
    b = subprocess.run(["du", "-sb", str(dest)], capture_output=True, text=True).stdout.split()[0]
    if a != b:
        die(f"size mismatch ({a} != {b}) — keeping the source")
    shutil.rmtree(src_dir)
    new_exe = dest / exe.name
    g["path"] = str(new_exe)
    registry_path(g["slug"]).write_text(json.dumps(g, indent=2, ensure_ascii=False) + "\n")
    print(f"done: {new_exe}")
    return new_exe



def _game_pids(g: dict, table=None) -> list[int]:
    """Processes belonging to a game (matched by exe name / prefix / game directory)."""
    table = table if table is not None else _proc_table()
    exe = os.path.basename(g.get("path") or "").lower()
    prefix = str(g.get("prefix") or (PREFIX_ROOT / g["slug"]))
    game_dir = str(Path(g.get("path") or "").parent)
    me = os.getpid()
    pids, seen = [], set()
    for pid, _et, cmd in table:
        if pid == me or pid in seen:
            continue
        low = cmd.lower()
        hit = (exe and exe in low) or (prefix and prefix in cmd) or (game_dir and game_dir in cmd)
        if not hit:
            continue
        # verify WINEPREFIX when readable so another game's processes are left alone
        try:
            env = Path(f"/proc/{pid}/environ").read_bytes().split(b"\0")
            wp = next((e.split(b"=", 1)[1].decode() for e in env if e.startswith(b"WINEPREFIX=")), "")
            if wp and prefix and os.path.realpath(wp) != os.path.realpath(prefix):
                continue
        except Exception:
            pass
        seen.add(pid)
        pids.append(pid)
    return pids


def _close_window(name: str) -> bool:
    """Close the game window (WM_CLOSE) so the game can exit cleanly."""
    try:
        clients = _hyprctl_json(["clients"]) or []
    except Exception:
        return False
    closers = []
    for c in clients:
        title = (c.get("title") or "").lower()
        klass = (c.get("class") or "").lower()
        if name.lower() in title or klass.startswith("steam_app"):
            if klass.startswith("steam_app") and name.lower() not in title:
                continue
            addr = c.get("address")
            if addr:
                closers.append(addr)
    ok = False
    for a in closers:
        r = subprocess.run(["hyprctl", "dispatch", "closewindow", f"address:{a}"],
                           capture_output=True, text=True)
        ok = ok or ("ok" in (r.stdout or "").lower())
    return ok


def cmd_stop(args) -> None:
    """Stop a running game (close window -> SIGTERM -> SIGKILL) and restore the display mode."""
    targets = all_games() if args.all else [load_game(args.slug)]
    table = _proc_table()
    any_running = False
    for g in targets:
        pids = _game_pids(g, table)
        if not pids:
            continue
        any_running = True
        print(f"▶ {g['name']}: {len(pids)} process(es) — stopping")
        if not args.force:
            if _close_window(g["name"]):
                print("  window closed (WM_CLOSE), waiting up to 6s…")
                for _ in range(12):
                    time.sleep(0.5)
                    if not _game_pids(g):
                        break
        pids = _game_pids(g)
        if pids and not args.force:
            print(f"  SIGTERM: {pids}")
            for pid in pids:
                subprocess.run(["kill", "-TERM", str(pid)], check=False)
            for _ in range(16):
                time.sleep(0.5)
                if not _game_pids(g):
                    break
        pids = _game_pids(g)
        if pids:
            print(f"  SIGKILL: {pids}")
            for pid in pids:
                subprocess.run(["kill", "-KILL", str(pid)], check=False)
            time.sleep(1.5)
        if _game_pids(g):
            print("  WARNING: some processes are still alive")
        else:
            print("  stopped")
    if not any_running:
        print("no such game is running")
    # restore the display mode if it was switched
    if STATE_FILE.exists():
        try:
            name, mode = STATE_FILE.read_text().split("\n")[:2]
            restore_monitor_mode((name, mode))
            STATE_FILE.unlink(missing_ok=True)
            print(f"display restored: {name} {mode}")
        except Exception as e:
            print(f"  (display restore failed: {e})")


