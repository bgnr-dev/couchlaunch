#!/usr/bin/env python3
"""gamelauncher — register and launch Windows games on Linux via Proton (umu-launcher),
with Sunshine/Moonlight streaming integration.

Parancsok:
  gamelauncher add <name> <dir|exe|archive> [--exe file.exe] [--args "..."] [--no-sync]
  gamelauncher add <name> --steam-appid <ID>          # game installed through Steam
  gamelauncher run <slug>                            # this is what Sunshine calls
  gamelauncher list
  gamelauncher sync [--restart]                      # regenerate Sunshine apps.json
  gamelauncher remove <slug> [--purge]

Registry:  ~/.config/game-launcher/games/<slug>.json
Prefixek:  ~/.local/share/game-prefixes/<slug>
Logok:     ~/.cache/game-launcher/<slug>.log
Games:      ~/Games (default target for archive extraction)
"""
from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
CONF_DIR = HOME / ".config/game-launcher"
GAMES_DIR = CONF_DIR / "games"
LOG_DIR = HOME / ".cache/game-launcher"
SUNSHINE_APPS = HOME / ".config/sunshine/apps.json"


def _load_settings() -> dict:
    """~/.config/game-launcher/config.json: games_root, prefix_root, covers_root."""
    s = {"games_root": str(HOME / "Games"),
         "prefix_root": str(HOME / ".local/share/game-prefixes"),
         "covers_root": str(HOME / ".local/share/gamelauncher/covers")}
    f = CONF_DIR / "config.json"
    if f.exists():
        try:
            s.update({k: v for k, v in json.loads(f.read_text()).items() if k in s})
        except Exception:
            pass
    if os.environ.get("GAMECLI_GAMES_ROOT"):
        s["games_root"] = os.environ["GAMECLI_GAMES_ROOT"]
    if os.environ.get("GAMECLI_PREFIX_ROOT"):
        s["prefix_root"] = os.environ["GAMECLI_PREFIX_ROOT"]
    return s


_SETTINGS = _load_settings()
PREFIX_ROOT = Path(_SETTINGS["prefix_root"]).expanduser()
DEFAULT_GAMES_ROOT = Path(_SETTINGS["games_root"]).expanduser()
GAME_MARKERS = ("gamelauncher run", "gamecli run")   # legacy marker kept so old entries get replaced
SELF = str(Path(__file__).resolve())

SKIP_EXE = re.compile(
    r"(unins|setup|install|vcredist|dxsetup|dxwebsetup|dotnet|oalinst|"
    r"crash|report|helper|launcher_updater|eula|redist|_setup)",
    re.I,
)


def slugify(name: str) -> str:
    s = re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")
    return s or "game"


def die(msg: str, code: int = 1):
    print(f"HIBA: {msg}", file=sys.stderr)
    sys.exit(code)


def ensure_dirs():
    for d in (CONF_DIR, GAMES_DIR, PREFIX_ROOT, LOG_DIR):
        d.mkdir(parents=True, exist_ok=True)


def registry_path(slug: str) -> Path:
    return GAMES_DIR / f"{slug}.json"


def load_game(slug: str) -> dict:
    p = registry_path(slug)
    if not p.exists():
        die(f"no such registered game: {slug} (see: gamelauncher list)")
    return json.loads(p.read_text())


def all_games() -> list[dict]:
    ensure_dirs()
    out = []
    for p in sorted(GAMES_DIR.glob("*.json")):
        try:
            out.append(json.loads(p.read_text()))
        except Exception:
            print(f"warning: malformed registry file: {p}", file=sys.stderr)
    return out


def find_exe(folder: Path) -> Path | None:
    """Pick the most likely game executable inside a directory."""
    folder = folder.resolve()
    cands = [p for p in folder.rglob("*.exe") if p.is_file() and not SKIP_EXE.search(p.name)]
    if not cands:
        cands = [p for p in folder.rglob("*.exe") if p.is_file()]
    if not cands:
        return None
    stem = folder.name.lower()

    def score(p: Path):
        name = p.stem.lower()
        depth = len(p.relative_to(folder).parts)
        return (name == stem, stem in name or name in stem, p.stat().st_size, -depth)

    return max(cands, key=score)


def extract_archive(archive: Path, dest: Path) -> None:
    dest.mkdir(parents=True, exist_ok=True)
    suffix = archive.suffix.lower()
    if suffix in {".7z", ".zip", ".rar", ".tar", ".gz", ".xz", ".bz2"}:
        tool = shutil.which("7z") or shutil.which("7zz") or shutil.which("bsdtar")
        if not tool:
            die("no 7z/bsdtar available for extraction (install p7zip)")
        print(f"extracting: {archive.name} -> {dest}")
        cmd = [tool, "x", "-y", f"-o{dest}", str(archive)] if "7z" in tool else [tool, "-xf", str(archive), "-C", str(dest)]
        subprocess.run(cmd, check=True)
    else:
        die(f"unsupported archive: {archive.name}")


def looks_like_installer(path: Path) -> bool:
    name = path.name.lower()
    return name.startswith("setup") or "setup_" in name or name.startswith("install")



def is_repack(src: Path) -> bool:
    """FitGirl/DODI style repack: setup.exe + fg-*.bin (must be run, not extracted)."""
    if not src.is_dir():
        return False
    if list(src.glob("fg-*.bin")) or list(src.glob("fg-*.bin.*")):
        return True
    if "repack" in src.name.lower() and any(src.glob("*.bin")):
        return True
    return False



def extract_inno(installer: Path, dest: Path) -> None:
    """Extract an Inno Setup / GOG offline installer — deliberately not run under Wine."""
    tool = shutil.which("innoextract")
    if not tool:
        die("nincs innoextract (sudo pacman -S innoextract)")
    if not dest.exists() and not os.access(dest.parent, os.W_OK):
        die(f"no write permission for {dest.parent} — sudo mkdir -p {dest.parent} && sudo chown $USER:$USER {dest.parent}")
    dest.mkdir(parents=True, exist_ok=True)
    print(f"extracting Inno/GOG installer: {installer.name} -> {dest}")
    subprocess.run([tool, "-e", "-d", str(dest), str(installer)], check=True)


def sunshine_restart_if_idle() -> None:
    # Never interrupt an active stream — just report it.
    try:
        tcp = subprocess.run(["ss", "-Htn", "state", "established"],
                             capture_output=True, text=True, timeout=5).stdout
        udp = subprocess.run(["ss", "-Hun"], capture_output=True, text=True, timeout=5).stdout
        ports_tcp = (":47984", ":48010", ":47989")
        ports_udp = (":47998", ":47999", ":48000")
        busy = any(p in line for line in tcp.splitlines() for p in ports_tcp)
        busy = busy or any(p in line for line in udp.splitlines() for p in ports_udp)
    except Exception:
        busy = False
    if busy:
        print("  (STREAM ACTIVE — not restarting Sunshine, that would kill the running game.)")
        print("  The change applies on the next Sunshine start; or end the stream and run:")
        print("  gamelauncher sync --restart")
        return
    unit = "app-dev.lizardbyte.app.Sunshine.service"
    # rapid successive restarts trip systemd's start-limit — reset-failed + short pause
    stamp = LOG_DIR / ".last-sunshine-restart"
    try:
        last = float(stamp.read_text().strip())
    except Exception:
        last = 0.0
    wait = 8.0 - (time.time() - last)
    if 0 < wait < 8:
        time.sleep(wait)
    subprocess.run(["systemctl", "--user", "reset-failed", unit], capture_output=True)
    r = subprocess.run(["systemctl", "--user", "restart", unit], capture_output=True)
    try:
        LOG_DIR.mkdir(parents=True, exist_ok=True)
        stamp.write_text(str(time.time()))
    except Exception:
        pass
    if r.returncode != 0:
        print(f"  WARNING: Sunshine restart failed: {r.stderr.decode().strip()[:120]}")
        print(f"  manually: systemctl --user reset-failed {unit} && systemctl --user start {unit}")
        return
    print("  Sunshine restarted (new app entry loaded)")


def sync_sunshine(restart: bool = False) -> None:
    games = [g for g in all_games() if g.get("sunshine", True)]
    apps = {"env": {"PATH": "$(PATH):$(HOME)/.local/bin"}, "apps": []}
    if SUNSHINE_APPS.exists():
        try:
            existing = json.loads(SUNSHINE_APPS.read_text())
            apps["env"] = existing.get("env", apps["env"])
            apps["apps"] = [
                a for a in existing.get("apps", [])
                if not any(any(m in str(x) for m in GAME_MARKERS) for x in (a.get("detached", []) + [c.get("do", "") for c in a.get("prep-cmd", [])]))
            ]
        except Exception as e:
            die(f"cannot read existing apps.json ({e}) — refusing to overwrite")
    for g in games:
        apps["apps"].append({
            "name": g["name"],
            "detached": [f"setsid {SELF} run {g['slug']}"],
            # restores the display mode when the stream ends (client quit / game exit)
            "prep-cmd": [{"do": "true", "undo": f"{SELF} restoreres"}],
            "image-path": g.get("image", "steam.png"),
        })
    SUNSHINE_APPS.parent.mkdir(parents=True, exist_ok=True)
    tmp = SUNSHINE_APPS.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(apps, indent=2, ensure_ascii=False) + "\n")
    tmp.replace(SUNSHINE_APPS)
    print(f"Sunshine apps.json updated: {len(games)} game entries")
    for g in games:
        print(f"  - {g['name']}")
    if restart:
        sunshine_restart_if_idle()



STEAM_IMG = ("https://cdn.cloudflare.steamstatic.com/steam/apps/{appid}/{name}.jpg")



def steam_art(appid: str, tmp: Path) -> Path | None:
    """Download Steam cover art (library -> header -> appdetails header_image)."""
    for n in ("library_600x900", "header", "capsule_616x353"):
        f = tmp.with_suffix(".jpg")
        r = subprocess.run(["curl", "-fsSL", "-o", str(f), STEAM_IMG.format(appid=appid, name=n)],
                           capture_output=True)
        if r.returncode == 0 and f.exists() and f.stat().st_size > 5000:
            return f
    try:
        raw = subprocess.run(["curl", "-fsS", "--max-time", "20",
                              f"https://store.steampowered.com/api/appdetails?appids={appid}&l=english"],
                             capture_output=True, text=True, timeout=30).stdout
        url = (json.loads(raw).get(str(appid), {}).get("data") or {}).get("header_image") or ""
        if url:
            f = tmp.with_suffix(".jpg")
            r = subprocess.run(["curl", "-fsSL", "-o", str(f), url], capture_output=True)
            if r.returncode == 0 and f.exists() and f.stat().st_size > 5000:
                return f
    except Exception:
        pass
    return None




def sgdb_key() -> str:
    """SteamGridDB API key (~/.api_keys: SGDB_API_KEY=... or environment variable)."""
    k = os.environ.get("SGDB_API_KEY", "").strip()
    if k:
        return k
    f = HOME / ".api_keys"
    if f.exists():
        for line in f.read_text(errors="ignore").splitlines():
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            if "=" in line:
                if line.startswith("export "):
                    line = line[len("export "):].strip()
                name, val = line.split("=", 1)
                if name.strip().upper() in {"SGDB_API_KEY", "STEAMGRIDDB_API_KEY", "SGDB"}:
                    return val.strip().strip("\"'")
    return ""


def sgdb_art(name: str, appid: str, tmp: Path) -> Path | None:
    """Portrait (600x900) cover art from SteamGridDB, when an API key is configured."""
    key = sgdb_key()
    if not key:
        return None
    try:
        import urllib.parse
        q = urllib.parse.quote(name)
        r = subprocess.run(["curl", "-fsS", "--max-time", "20", "-H", f"Authorization: Bearer {key}",
                            f"https://www.steamgriddb.com/api/v2/search/autocomplete/{q}"],
                           capture_output=True, text=True, timeout=30)
        data = json.loads(r.stdout)
        items = (data.get("data") or [])
        if not items:
            return None
        gid = items[0]["id"]
        r2 = subprocess.run(["curl", "-fsS", "--max-time", "20", "-H", f"Authorization: Bearer {key}",
                             f"https://www.steamgriddb.com/api/v2/grids/game/{gid}?dimensions=600x900&types=static"],
                            capture_output=True, text=True, timeout=30)
        grids = json.loads(r2.stdout).get("data") or []
        if not grids:
            return None
        url = grids[0].get("url") or ""
        if not url:
            return None
        f = tmp.with_suffix(".sgdb.png")
        r3 = subprocess.run(["curl", "-fsSL", "-o", str(f), url], capture_output=True)
        if r3.returncode == 0 and f.exists() and f.stat().st_size > 5000:
            print(f"SteamGridDB cover: {items[0].get('name')} (grid {gid})")
            return f
    except Exception as e:
        print(f"  (SteamGridDB unavailable: {e})")
    return None



def cmd_icon(args) -> None:
    """Set a game icon/cover (the tile shown by Sunshine/Moonlight)."""
    g = load_game(args.slug)
    img_dir = Path(_SETTINGS.get("covers_root") or (DEFAULT_GAMES_ROOT.parent / ".covers")).expanduser()
    img_dir.mkdir(parents=True, exist_ok=True)
    dest = img_dir / f"{g['slug']}.png"
    tmp = Path("/tmp") / f"icon-{g['slug']}"
    src = None
    if args.file:
        src = Path(args.file).expanduser()
        if not src.exists():
            die(f"no such file: {src}")
    elif args.url:
        src = tmp.with_suffix(".img")
        subprocess.run(["curl", "-fsSL", "-o", str(src), args.url], check=True)
    elif args.steam_appid:
        appid = str(args.steam_appid)
        src = steam_art(appid, tmp)
        if not src:
            die(f"could not download cover art for AppID {appid}")
    else:
        # no explicit source: search the Steam store by game name
        appid = str(g.get("steam_appid") or "")
        if not appid:
            import urllib.parse
            q = urllib.parse.quote(g["name"])
            try:
                raw = subprocess.run(["curl", "-fsS", "--max-time", "20",
                                      f"https://store.steampowered.com/api/storesearch/?term={q}&l=english&cc=US"],
                                     capture_output=True, text=True, timeout=30).stdout
                items = json.loads(raw).get("items", [])
            except Exception:
                items = []
            if not items:
                die(f"not found on Steam: {g['name']} — pass --file/--url/--steam-appid instead")
            exact = [i for i in items if i["name"].strip().lower() == g["name"].strip().lower()]
            pick = (exact or items)[0]
            appid = str(pick["id"])
            print(f"Steam match: {pick['name']} (AppID {appid})")
        args.steam_appid = appid
        src = steam_art(appid, tmp)
        if not src:
            die(f"could not download cover art for AppID {appid}")
    # when a SteamGridDB key exists, prefer its portrait (600x900) covers
    if getattr(args, "sgdb", False) and not sgdb_key():
        print("  (no SGDB_API_KEY in ~/.api_keys — falling back to Steam cover art)")
    sg = sgdb_art(g["name"], str(args.steam_appid or g.get("steam_appid") or ""), tmp) if not args.file else None
    if sg:
        src = sg

    # normalise to a 600x900 PNG (Moonlight tile): crop portrait, blur-pad landscape
    wh = subprocess.run(["magick", "identify", "-format", "%w %h", str(src)],
                        capture_output=True, text=True).stdout.split()
    try:
        iw, ih = int(wh[0]), int(wh[1])
    except Exception:
        iw, ih = 0, 0
    if iw and ih and (ih / iw) >= 1.15:
        # already portrait (box art): fill + centre crop
        subprocess.run(["magick", str(src), "-resize", "600x900^", "-gravity", "center",
                        "-extent", "600x900", str(dest)], check=True)
    else:
        # landscape (header/capsule): blurred backdrop + untouched, centred artwork
        subprocess.run([
            "magick",
            "(", str(src), "-resize", "600x900^", "-gravity", "center", "-extent", "600x900",
            "-blur", "0x28", "-modulate", "85,90", ")",
            "(", str(src), "-resize", "600x840", "-background", "none", "-gravity", "center",
            "-extent", "600x900", ")",
            "-gravity", "center", "-composite", str(dest)
        ], check=True)
    g["image"] = str(dest)  # absolute path required: Sunshine resolves relative names in its assets dir
    registry_path(g["slug"]).write_text(json.dumps(g, indent=2, ensure_ascii=False) + "\n")
    print(f"icon set: {dest} ({dest.stat().st_size // 1024} KB)")
    sync_sunshine(restart=True)


def cmd_add(args) -> None:
    ensure_dirs()
    name = args.name
    slug = args.slug or slugify(name)
    entry = {
        "name": name,
        "slug": slug,
        "type": "steam" if args.steam_appid else "proton",
        "args": args.args or "",
        "sunshine": True,
        "image": args.image or "steam.png",
        "created": time.strftime("%Y-%m-%d %H:%M:%S"),
    }

    if args.steam_appid:
        entry["steam_appid"] = str(args.steam_appid)
        print(f"Steam game registered: {name} (AppID {args.steam_appid})")
    else:
        if not args.path:
            die("pass a directory/file, or use the --steam-appid option")
        src = Path(args.path).expanduser()
        if not src.exists():
            die(f"no such file/directory: {src}")
        if src.is_file() and src.suffix.lower() in {".7z", ".zip", ".rar", ".tar", ".gz", ".xz", ".bz2"}:
            dest = Path(args.dest or (DEFAULT_GAMES_ROOT / name))
            extract_archive(src, dest)
            src = dest
        # Scene ISO (installer release): mount it, the installer is a separate step
        if src.is_file() and src.suffix.lower() == ".iso":
            mnt = mount_iso(src, slug)
            entry["iso"] = str(src)
            entry["iso_mount"] = str(mnt)
            setup = find_installer(mnt)
            crack = find_crack_dir(mnt)
            if crack:
                entry["crack_dir"] = str(crack)
            if setup:
                entry["installer"] = str(setup)
                registry_path(slug).write_text(json.dumps(entry, indent=2, ensure_ascii=False) + "\n")
                print(f"Scene ISO felcsatolva: {mnt}")
                print(f"  installer: {setup.name}")
                if crack:
                    print(f"  crack:    {crack.name}")
                print(f"\nNext step:  gamelauncher install {slug}")
                print("  (the installer runs under Proton; its GUI appears on the desktop / in the stream)")
                if not args.no_sync:
                    sync_sunshine(restart=True)
                return
            # no installer found: maybe the ISO already contains a ready-to-run game
            src = mnt

        # FitGirl/DODI repack: a setup.exe-t Proton alatt KELL futtatni (nem csomagoljuk ki)
        if src.is_dir() and is_repack(src):
            setup = next((p for p in sorted(src.glob("*.exe")) if looks_like_installer(p)), None) or (src / "setup.exe")
            entry["installer"] = str(setup)
            entry["prefix"] = str(PREFIX_ROOT / slug)
            registry_path(slug).write_text(json.dumps(entry, indent=2, ensure_ascii=False) + "\n")
            print(f"Repack felismerve: {src}")
            print(f"  installer: {setup.name}  (+ {len(list(src.glob('*.bin')))} .bin files)")
            print(f"\nNext step:  gamelauncher install {slug}")
            print("  (the installer runs under Proton; its GUI appears on the desktop / in the stream;")
            print("   for 60+ GB this can take 1-2 hours)")
            if not args.no_sync:
                sync_sunshine(restart=True)
            return

        # Inno/GOG offline installer (setup*.exe + .bin) — extract it, do not run it
        inst = None
        if src.is_dir():
            inst = next((p for p in sorted(src.glob("*.exe")) if looks_like_installer(p)), None)
            if inst and not any(src.glob("*.bin")):
                inst = None
        elif src.is_file() and src.suffix.lower() == ".exe" and looks_like_installer(src):
            inst = src
        if inst is not None:
            dest = Path(args.dest or (DEFAULT_GAMES_ROOT / name))
            extract_inno(inst, dest)
            src = dest

        if src.is_file() and src.suffix.lower() == ".exe":
            exe = src.resolve()
        else:
            exe = None
            if args.exe:
                exe = (src / args.exe).resolve()
                if not exe.exists():
                    die(f"the given exe does not exist: {exe}")
            else:
                exe = find_exe(src)
                if not exe:
                    die(f"no .exe found in: {src}")
        entry["path"] = str(exe)
        entry["prefix"] = str(Path(args.prefix).expanduser() if args.prefix else PREFIX_ROOT / slug)
        if args.proton:
            entry["protonpath"] = args.proton
        print(f"Proton game registered: {name}")
        print(f"  exe:    {entry['path']}")
        print(f"  prefix: {entry['prefix']}")

    registry_path(slug).write_text(json.dumps(entry, indent=2, ensure_ascii=False) + "\n")
    if not args.no_sync:
        sync_sunshine(restart=True)



# ---------- follow the client resolution (Sunshine -> Hyprland) ----------

def _hypr_sig() -> str | None:
    """Live Hyprland instance signature (Sunshine's env copy is not always current)."""
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if sig:
        return sig
    base = Path(f"/run/user/{os.getuid()}/hypr")
    if not base.is_dir():
        return None
    dirs = sorted(base.iterdir(), key=lambda d: d.stat().st_mtime, reverse=True)
    for d in dirs:
        env = os.environ.copy()
        env.setdefault("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
        env["HYPRLAND_INSTANCE_SIGNATURE"] = d.name
        r = subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True, env=env)
        if r.stdout.strip().startswith("["):
            return d.name
    return None


def _hypr_env() -> dict:
    env = os.environ.copy()
    env.setdefault("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    sig = _hypr_sig()
    if sig:
        env["HYPRLAND_INSTANCE_SIGNATURE"] = sig
    return env


def _hyprctl_json(cmd: list[str]):
    env = _hypr_env()
    r = subprocess.run(["hyprctl"] + cmd + ["-j"], capture_output=True, text=True, env=env)
    try:
        return json.loads(r.stdout)
    except Exception:
        return None


def _fmt_refresh(rate: float) -> str:
    return f"{rate:.1f}" if abs(rate - round(rate)) > 0.01 else str(int(round(rate)))


def set_monitor_mode(width: int, height: int, fps: float | None = None) -> tuple[str, str] | None:
    """Switch the first monitor to the requested mode; returns (output, original_mode)."""
    mons = _hyprctl_json(["monitors"])
    if not isinstance(mons, list) or not mons:
        return None
    m = mons[0]
    name = m.get("name")
    cur_w, cur_h = int(m.get("width", 0)), int(m.get("height", 0))
    cur_rate = float(m.get("refreshRate", 60) or 60)
    original = f"{cur_w}x{cur_h}@{_fmt_refresh(cur_rate)}"
    if cur_w <= width and cur_h <= height:
        return None  # nothing to switch
    rate = fps or cur_rate
    # pick the closest available refresh rate for the requested resolution
    modes = m.get("availableModes") or []
    want = f"{width}x{height}"
    cands = [x for x in modes if x.startswith(want + "@")]
    if cands:
        avail = [float(x.split("@")[1].rstrip("Hz")) for x in cands]
        rate = min(avail, key=lambda r: (abs(r - float(fps or cur_rate)), -r))
    mode = f"{width}x{height}@{_fmt_refresh(rate)}"
    scale = m.get("scale", 1)
    expr = f'hl.monitor({{ output = "{name}", mode = "{mode}", position = "0x0", scale = {scale} }})'
    r = subprocess.run(["hyprctl", "eval", expr], capture_output=True, text=True, env=_hypr_env())
    print(f"display: {name} {original} -> {mode} ({r.stdout.strip()})")
    return (name, original)


def restore_monitor_mode(saved: tuple[str, str] | None) -> None:
    if not saved:
        return
    name, mode = saved
    expr = f'hl.monitor({{ output = "{name}", mode = "{mode}", position = "0x0", scale = 1.0 }})'
    subprocess.run(["hyprctl", "eval", expr], capture_output=True, text=True, env=_hypr_env())
    print(f"display restored: {name} {mode}")

